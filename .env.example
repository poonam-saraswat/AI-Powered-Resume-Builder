# ==========================================================================
# ResumeAI — environment template
# Copy this file to `.env` and fill in the values marked CHANGEME.
# ==========================================================================

# ---- JWT (CHANGEME — any random 64-char string) -------------------------
JWT_SECRET=please-replace-with-a-long-random-string-min-32-chars

# ---- Postgres (default works inside docker-compose) ---------------------
POSTGRES_USER=resumeai
POSTGRES_PASSWORD=resumeai

# ---- Google OAuth (CHANGEME) --------------------------------------------
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub OAuth (CHANGEME) --------------------------------------------
# Get from https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Frontend redirect after OAuth login --------------------------------
FRONTEND_REDIRECT_URI=http://localhost:4200/oauth/callback

# ---- AI (one of these) --------------------------------------------------
# Lovable AI Gateway key OR your own OpenAI-compatible key
LOVABLE_API_KEY=
OPENAI_API_KEY=
AI_MODEL=google/gemini-3-flash-preview

# ---- Stripe (optional, leave blank to disable billing) ------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Mail (Mailhog runs in compose by default — no real SMTP needed) ----
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- CORS (frontend origins, comma-separated) ---------------------------
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
